# SENTINEL Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AssemblyAI ──────────────────────────────────────────────────────────────
# Get your key at https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── Agent configuration ─────────────────────────────────────────────────────
# Leave blank on first run — the backend will create the agent and print its ID.
# After creation, paste the returned agent ID here to reuse across restarts.
SENTINEL_AGENT_ID=

# ── Server ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Phase 5 — Incident persistence ──────────────────────────────────────────
# SQLite file for incidents + audit trail (stdlib sqlite3, isolated in app/risk/incidents.py).
SENTINEL_DB_PATH=sentinel.db

# ── Phase 5 — Supervisor notification (optional) ────────────────────────────
# If set, incident escalations POST a structured payload here.
# If left blank, notifications are recorded + logged as simulated (prototype mode).
SUPERVISOR_WEBHOOK_URL=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
